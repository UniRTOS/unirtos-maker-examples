if(NOT TARGET mbedtls OR NOT CONFIG_QCM_MBEDTLS_2_LIBRARY_FUNC)
    message(FATAL_ERROR "Coze requires SDK complete Mbed TLS 2.x library enabled")
endif()
set(_coze_tls2 ${CMAKE_SOURCE_DIR}/qos_components/components/mbedtls/mbedtls2)
set(_coze_tls_stage ${CMAKE_BINARY_DIR}/coze_full_tls)
file(MAKE_DIRECTORY ${_coze_tls_stage})
file(GLOB_RECURSE _coze_tls_files ${_coze_tls2}/include/*.h ${_coze_tls2}/library/*.h ${_coze_tls2}/library/*.c)
set(_coze_tls_identifiers)
set(_coze_tls_macros)
foreach(_source IN LISTS _coze_tls_files)
    file(READ ${_source} _text)
    string(REGEX MATCHALL "mbedtls_[A-Za-z0-9_]+" _names "${_text}")
    list(APPEND _coze_tls_identifiers ${_names})
    string(REGEX MATCHALL "#[ \t]*define[ \t]+mbedtls_[A-Za-z0-9_]+" _defs "${_text}")
    foreach(_def IN LISTS _defs)
        string(REGEX REPLACE ".*(mbedtls_[A-Za-z0-9_]+)$" "\\1" _macro "${_def}")
        list(APPEND _coze_tls_macros ${_macro})
    endforeach()
endforeach()
list(REMOVE_DUPLICATES _coze_tls_identifiers)
list(REMOVE_DUPLICATES _coze_tls_macros)
list(REMOVE_ITEM _coze_tls_identifiers ${_coze_tls_macros})
list(SORT _coze_tls_identifiers)
set(_namespace "/* Generated from the selected SDK library. No credentials. */\n")
foreach(_name IN LISTS _coze_tls_identifiers)
    string(APPEND _namespace "#define ${_name} coze_${_name}\n")
endforeach()
file(WRITE ${_coze_tls_stage}/coze_tls_namespace.h "${_namespace}")
target_sources(mbedtls PRIVATE ${_coze_dir}/tls_platform.c)
foreach(_consumer mbedtls vtls qcm_websocket utils)
    target_include_directories(${_consumer} BEFORE PRIVATE
        ${_coze_tls2}/include ${_coze_dir} ${_coze_tls_stage})
    target_compile_options(${_consumer} PRIVATE -include ${_coze_dir}/tls_build.h)
endforeach()
message(STATUS "Coze: full SDK TLS2 library + isolated symbols, not native NOT SUPPORT wrappers")